    "db:migrate": "wrangler d1 migrations apply pulse-desk --local --persist-to ../.wrangler/state"
  },
  "dependencies": {
    "@pulse/shared": "*",
    "hono": "^4.10.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251014.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0"
  }
}
