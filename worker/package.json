{
  "name": "@pulse/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --ip 127.0.0.1 --persist-to ../.wrangler/state",
    "typecheck": "tsc --noEmit",
